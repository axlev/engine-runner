{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engine-runner.internal/schemas/review-a.schema.json",
  "title": "Review A - discovery findings",
  "description": "Output of reasoner-1, the discovery reviewer. Reasoner 1 sees only the prospective bundle and proposes candidate findings with high recall. Nothing here has been substantiated yet.",
  "type": "object",
  "required": ["schema_version", "run_id", "case_id", "stage", "generated_at", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "review-a/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "stage": { "const": "reasoner-1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "string",
      "description": "Optional free-text overview of the review pass."
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "title", "description", "severity", "confidence", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier unique within this review, referenced verbatim by later stages."
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "description": "Free-text defect category, e.g. correctness, security, concurrency, resource-leak."
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "uncertainty": {
          "type": "string",
          "description": "What would change the reviewer's confidence, or what was not verified."
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "excerpt": { "type": "string" }
      }
    }
  }
}
